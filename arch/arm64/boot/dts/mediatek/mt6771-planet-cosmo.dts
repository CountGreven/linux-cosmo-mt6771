// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Planet Computers Cosmo Communicator (board k71v1_64_bsp) on MediaTek MT6771.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/adc/mediatek,mt6370_adc.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/usb/pd.h>
#include "mt6771.dtsi"
/* The MT6358 PMIC, so regulators exist at all. LK reports its chip code as 0x5820, which the vendor
 * kernel's mtk_pmic_info.h defines as PMIC6358_E2_CID_CODE. Otto Pflueger's tree includes it too. */
#include "mt6358.dtsi"

/ {
	model = "Planet Computers Cosmo Communicator";
	chassis-type = "handset";
	compatible = "planet,cosmo", "mediatek,mt6771";

	aliases {
		serial0 = &uart0;
		/* The SD card probes first and took mmcblk0; root= names the eMMC as mmcblk0p43. */
		mmc0 = &mmc0;
		mmc1 = &mmc1;
	};

	memory@40000000 {
		device_type = "memory";
		/*
		 * 6 GiB from 0x40000000. Two independent sources: the device
		 * owner, and Otto Pflueger's mt6771-planet-cosmocom.dts:29
		 * (reg = <0 0x40000000 1 0x80000000>). The vendor's own size,
		 * 0x1e605000 (V:226), is a bring-up value that stops at the
		 * framebuffer base and is not used. The base is the vendor's.
		 * Not proven: that the range is contiguous, with no hole the
		 * firmware owns; only a boot settles that.
		 */
		reg = <0 0x40000000 1 0x80000000>;
	};

	chosen {
		/* 921600 from vendor mt6771.dts:32 (console=ttyS0,921600n1) */
		stdout-path = "serial0:921600";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * NO simple-framebuffer here, and the reason is worth keeping.
		 *
		 * We derived a handover framebuffer at 0x5e605000 from chosen/atag,videolfb-fb_base_l and
		 * reserved it. LK rejected the whole device tree for it:
		 *
		 *   reserved_memory_conflict_check fatal error keep while (1)
		 *
		 * then spun until the watchdog. Its own log says why: free memory resumes at 0x5e900000, and
		 * 0x56900000-0x5e900000 is LK's scratch_addr_mb -- the buffer it decompresses the kernel into.
		 * 0x5e605000 is inside it. That address is LK's workspace, not a framebuffer it hands over.
		 *
		 * The live device tree's real display reservation is mblock-7-framebuffer at 0x7df70000, which
		 * is reserved below and is the address Otto Pflueger's tree uses -- commented out there too.
		 * If a screen console is wanted later, that is where to start, and its geometry needs proving
		 * against a boot rather than against an atag.
		 */
	};

	/*
	 * Targets for the vendor device-tree overlay. Not hardware.
	 *
	 * MediaTek's LK applies the overlay in the device's dtbo partition to whatever tree it finds in the
	 * boot image, and it is not optional: when a fixup cannot be resolved it does not fall back, it
	 * asserts, and the kernel never runs. Read out of expdb after a silent boot:
	 *
	 *   ERROR: ufdt_overlay_do_fixups():No node __symbols__ in main dtb.
	 *   ufdt_apply_overlay() failed!
	 *   panic (caller 0x5602c2d3): ASSERT at (app/mt_boot/fdt_op.c:212): 0
	 *
	 * The overlay names 61 symbols. Inheriting mt8183.dtsi supplies 18 of them; these
	 * 43 are vendor board labels with no mainline equivalent. They exist so the overlay
	 * resolves and LK proceeds, and they are deliberately empty and disabled so that whatever the overlay
	 * writes into them binds to nothing. Pointing them at real nodes would let 280 fragments of downstream
	 * properties into hardware we do describe.
	 *
	 * ci/check-dtbo-symbols.py reads the requirement out of the real dtbo partition, so this list cannot
	 * drift from the device without the build failing.
	 */
	lk-dtbo-stubs {
		status = "disabled";

		accdet: accdet-stub { };
		als: als-stub { };
		apuart0: apuart0-stub { };
		audgpio: audgpio-stub { };
		aw9523_eint: aw9523-eint-stub { };
		aw9523_key: aw9523-key-stub { };
		aw9524_key: aw9524-key-stub { };
		charger: charger-stub { };
		chosen: chosen-stub { };
		consys: consys-stub { };
		cs_finger: cs-finger-stub { };
		dsi_te: dsi-te-stub { };
		finger: finger-stub { };
		finger_key: finger-key-stub { };
		fusb301a: fusb301a-stub { };
		gpio: gpio-stub { };
		gpio_usage_mapping: gpio-usage-mapping-stub { };
		gyro: gyro-stub { };
		hall: hall-stub { };
		irq_nfc: irq-nfc-stub { };
		irtx_pwm: irtx-pwm-stub { };
		kd_camera_hw1: kd-camera-hw1-stub { };
		keypad: keypad-stub { };
		main_pmic: main-pmic-stub { };
		md1_sim1_hot_plug_eint: md1-sim1-hot-plug-eint-stub { };
		msdc1_ins: msdc1-ins-stub { };
		mt6370_pmu: mt6370-pmu-stub { };
		mt6370_typec: mt6370-typec-stub { };
		mt_pmic_vcama1_ldo_reg: mt-pmic-vcama1-ldo-reg-stub { };
		mt_pmic_vcama2_ldo_reg: mt-pmic-vcama2-ldo-reg-stub { };
		mt_pmic_vcamd_ldo_reg: mt-pmic-vcamd-ldo-reg-stub { };
		mt_pmic_vcamio_ldo_reg: mt-pmic-vcamio-ldo-reg-stub { };
		mt_pmic_vldo28_ldo_reg: mt-pmic-vldo28-ldo-reg-stub { };
		mt_pmic_vsim1_ldo_reg: mt-pmic-vsim1-ldo-reg-stub { };
		mt_pmic_vsim2_ldo_reg: mt-pmic-vsim2-ldo-reg-stub { };
		odm: odm-stub { };
		pmic_clock_buffer_ctrl: pmic-clock-buffer-ctrl-stub { };
		reserved_memory: reserved-memory-stub { };
		sii9022: sii9022-stub { };
		stm32_key: stm32-key-stub { };
		subpmic_pmu_eint: subpmic-pmu-eint-stub { };
		tcpc_pd: tcpc-pd-stub { };
		touch: touch-stub { };
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Only what LK does NOT reserve itself.
		 *
		 * The firmware regions this file used to declare -- atf, spm, sspm, tee, log_store, framebuffer,
		 * three ccci, scp, vpu, the dramc ranks -- were transcribed from the live device tree of the
		 * running vendor kernel. That was a mistake in reasoning: the live tree is what the kernel
		 * receives AFTER LK has injected its own reservations, not what the vendor's source declares.
		 * Declaring them again collides with the originals, and LK refuses the tree outright:
		 *
		 *   DTS node:atf@54600000 reserved start: 0x54600000 size: 0x40000
		 *   reserved_memory_conflict_check:1168 failed i:3 0:1:1:1
		 *   reserved_memory_conflict_check fatal error keep while (1)
		 *
		 * atf@54600000 is byte-identical to LK's own atf-reserved. The three nodes that passed the check
		 * -- ramoops, ram-console, minirdump -- are precisely the ones LK does not inject.
		 *
		 * So the firmware regions still reach the kernel; they arrive from the bootloader, which is how
		 * the vendor kernel gets them too. Dynamic reservations (no fixed reg) are fine: they cannot
		 * collide, and LK looks reserve-memory-sspm_share up by name.
		 */

		/*
		 * The vendor pstore (V:298-301). Mainline ramoops takes the
		 * place of the vendor's own pstore. Sizes are the vendor's:
		 * console/pmsg from k71v1_64_bsp_defconfig:496-497, and the
		 * 4096-byte record size is the vendor ram.c default (ram.c:41).
		 * No no-map: it has to be mapped to be read back.
		 */
		ramoops@54410000 {
			compatible = "ramoops";
			reg = <0 0x54410000 0 0xe0000>;
			record-size = <0x1000>;
			/* Console last, 64 KiB, no pmsg: that puts it at 0x544e0000, the one part of this
			 * region the vendor kernel has read our writes back from every time (11-console-zone). */
			console-size = <0x10000>;
		};

		/* Vendor ram_console (V:302-305) and minirdump (V:306-309). */
		ram-console@54400000 {
			reg = <0 0x54400000 0 0x10000>;
		};

		minirdump@544f0000 {
			reg = <0 0x544f0000 0 0x10000>;
		};

		/*
		 * Regions the firmware owns, at the addresses it chose for
		 * this boot, from the live device tree the bootloader hands
		 * the vendor kernel (notes: probes/2026-09-24-1702-live.dts,
		 * reserved-memory node; line numbers below are that file's).
		 * The vendor source only declares most of these dynamically.
		 * Not reserving them lets the page allocator hand ATF, TEE or
		 * modem memory to the kernel. All no-map except where noted.
		 *
		 * The addresses are as observed on one boot. If LK places them
		 * differently on another boot these are wrong; see the notes.
		 */

		/* live:6017 mblock-10-SCP-reserved */
		/*
		 * live:5942 reserve-memory-sspm_share. LK looks this up by literal path,
		 * "/reserved-memory/reserve-memory-sspm_share", and writes "okay" into its status property --
		 * which is why the live tree shows status = <0x6f6b6179>, "okay" as a u32. Without the node LK
		 * logs "SSPM: no reserved mem found, skip" and shortly afterwards asserts. Values are the
		 * device's, not invented: a dynamic reservation rather than a fixed one.
		 */
		reserve-memory-sspm_share {
			compatible = "mediatek,reserve-memory-sspm_share";
			size = <0 0x510000>;
			alloc-ranges = <0 0x40000000 0 0x60000000>;
			alignment = <0 0x10000>;
			no-map;
		};

		/*
		 * The three pools below are placed by the kernel at boot from
		 * size, alignment and alloc-ranges (as in the vendor), not at a
		 * fixed address, and nothing consumes them until the SSPM, SCP
		 * and connsys drivers exist.
		 */

		/* V:331-337 */
		consys {
			no-map;
			size = <0 0x200000>;
			alignment = <0 0x200000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};
	};

};

&uart0 {
	status = "okay";
};

/*
 * LK finds the SCP node by the vendor compatible "mediatek,scp" and reads its sram size from reg[0].
 * Without it: "[SCP] platform_fdt_scp: getting node from dtb fails". mt8183.dtsi's node already carries
 * the right reg -- sram at 0x10500000 size 0x80000, identical to the vendor tree (live:7006) -- so all
 * it needs is the name the bootloader looks for. The node stays disabled; LK only reads it.
 */
&scp {
	compatible = "mediatek,mt8183-scp", "mediatek,scp";

	/*
	 * LK reserves the SCP firmware region itself -- SCP-reserved at 0x9cf00000 in its own
	 * mblock_reserve list -- and rejects the whole device tree if we declare it a second time. So drop
	 * mt8183.dtsi's reference rather than duplicate LK's region. The node is disabled here in any case;
	 * when SCP is actually brought up, take the region from what LK injects rather than declaring one.
	 */
	/delete-property/ memory-region;
};

/*
 * The display, described rather than left to be discovered.
 *
 * mt8183.dtsi brings the whole display pipeline with it, so mtk_drm bound and started driving the panel
 * with no panel node, no endpoint graph and no supplies -- which is what put garbage on the screen and is
 * a plausible place to wedge. This is Otto Pflueger's description, minus the backlight: his points at the
 * MT6370 PMU on i2c, which we have not wired yet, and panel-simple treats backlight as optional. The
 * screen will stay dark; we read the log through pstore, not the screen.
 */
&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	panel: panel@0 {
		compatible = "planet,cosmocom-x800-datong-panel";
		reg = <0>;
		rotation = <270>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

/* mt8183.dtsi already declares dsi0's ports and labels its output endpoint, so wire that one up rather
 * than declaring a second. */
&dsi_out {
	remote-endpoint = <&panel_in>;
};

/*
 * eMMC and SD card. These two are the only nodes in this file that are meant to be live before root
 * mounts; everything else the board description adds is disabled and is switched on per flash.
 *
 * The vendor calls them msdc@11230000 and msdc@11240000 (live.dts:294, :320); mainline's mt8183-mmc
 * binding drives the same controllers. Capabilities, bus width and supplies are the vendor's.
 *
 * Drive strength is the VENDOR's, not Otto Pflueger's. The live tree's msdc pin groups
 * (live.dts:1212 msdc0@default, :1243 msdc1@default and its sdr104/sdr50/ddr50 twins) carry a register
 * field of 4 for msdc0 and 3 for msdc1, in 2 mA steps from 2 mA: 10 mA and 8 mA. Otto's tree, and the
 * mt8183 boards it was copied from, use 14 mA and 10 mA. The two disagree; the vendor's are what this
 * board ran with, so they are used here, and only a boot on this device can say whether they are enough
 * at HS400.
 *
 * The vendor groups set drive strength only: the pads are muxed by LK, and the pinmux and pull settings
 * below are the mt8183 boards' (the SoC's pad design is shared). STAND-IN: the pull-up/pull-down
 * settings, until measured against the vendor's msdc register dump. The *-adv properties take the
 * 2-bit register value as a number (0-3); mt8183-kukui writes them as <10> and <01>, which dtc reads as
 * decimal ten and (octal) one, and the schema rejects the ten. <2> is the binary 10 those boards mean.
 */
&mmc0 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	cap-mmc-hw-reset;
	no-sdio;
	no-sd;
	/*
	 * STAND-IN: the mt8183 HS400 data-strobe delay (mt8183-kukui and Otto's tree both carry it). The
	 * vendor has no such property; its tuning is done in the driver at run time. Replace with the value
	 * the eMMC tuning settles on.
	 */
	hs400-ds-delay = <0x12814>;
	non-removable;
	/*
	 * live.dts:317 vmmc-supply is the only supply the vendor gives msdc0. The mt8183-mmc binding
	 * requires a vqmmc-supply as well, so VIO18 goes there as in Otto's tree. STAND-IN: that choice has no
	 * vendor basis (nothing in live.dts consumes VIO18); it is the always-on 1.8 V I/O rail (mt6358.dtsi)
	 * the eMMC's I/O most plausibly sits on. WAITING: the board schematic.
	 */
	vmmc-supply = <&mt6358_vemc_reg>;
	vqmmc-supply = <&mt6358_vio18_reg>;
};

&mmc1 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	/*
	 * live.dts:332 cd-gpios = <&pio 3 0>, cd_level = 1. The vendor's sd.c:4511 sets
	 * card_inserted = (cd_level == level), so the card is present when the pin is HIGH: active high, the
	 * opposite of most boards. gpio.txt shows gpio-323 (base 320 + pin 3) "in hi" with the pin claimed
	 * by "cd". WAITING: confirm with a card in and out.
	 */
	cd-gpios = <&pio 3 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6358_vmch_reg>;
	vqmmc-supply = <&mt6358_vmc_reg>;
};

&pio {
	mmc0_pins_default: mmc0-pins-default {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_10mA>;
			mediatek,pull-up-adv = <1>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_10mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_10mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_10mA>;
			mediatek,pull-down-adv = <1>;
		};
	};

	/* The vendor has one msdc0 state (live.dts:1212); the UHS state repeats it. */
	mmc0_pins_uhs: mmc0-pins-uhs {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_10mA>;
			mediatek,pull-up-adv = <1>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_10mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_10mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_10mA>;
			mediatek,pull-down-adv = <1>;
		};
	};

	/* live.dts:1243; sdr104, sdr50 and ddr50 (:1259-:1291) are identical, so one state serves. */
	mmc1_pins_default: mmc1-pins-default {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO31__FUNC_MSDC1_CMD>,
				 <PINMUX_GPIO32__FUNC_MSDC1_DAT0>,
				 <PINMUX_GPIO34__FUNC_MSDC1_DAT1>,
				 <PINMUX_GPIO33__FUNC_MSDC1_DAT2>,
				 <PINMUX_GPIO30__FUNC_MSDC1_DAT3>;
			input-enable;
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-up-adv = <2>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO29__FUNC_MSDC1_CLK>;
			input-enable;
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-cd {
			pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
			input-enable;
			bias-pull-up;
		};
	};

	mmc1_pins_uhs: mmc1-pins-uhs {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO31__FUNC_MSDC1_CMD>,
				 <PINMUX_GPIO32__FUNC_MSDC1_DAT0>,
				 <PINMUX_GPIO34__FUNC_MSDC1_DAT1>,
				 <PINMUX_GPIO33__FUNC_MSDC1_DAT2>,
				 <PINMUX_GPIO30__FUNC_MSDC1_DAT3>;
			input-enable;
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-up-adv = <2>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO29__FUNC_MSDC1_CLK>;
			input-enable;
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-cd {
			pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
			input-enable;
			bias-pull-up;
		};
	};
};

/*
 * The MT6358's interrupt line: pin 182, the vendor's "pmic-eint" (interrupts.txt in the runtime
 * snapshot: mtk-eint 182 Level pmic-eint). Without it the mt6397 MFD core fails to probe
 * ("pmic: IRQ index 0 not found", first console log), and every MT6358 regulator, the MFG power
 * domain and the eMMC's supplies go with it. Same pin as mt8183-kukui.
 */
&pmic {
	interrupts-extended = <&pio 182 IRQ_TYPE_LEVEL_HIGH>;
};

/*
 * The MFG power domains need their rails or the whole power controller fails to probe
 * ("power-domain@2: failed to get power supply", console log 2026-09-25), which leaves every
 * display block and the GPU waiting for it forever. Same rails as mt8183-kukui; the vendor's GPU
 * DVFS log confirms VGPU and VSRAM_GPU (vendor-boot.log: "VGPU is enabled = 1 (900 mV), VSRAM_GPU
 * is enabled = 1 (1000 mV)").
 */
&mfg_async {
	domain-supply = <&mt6358_vsram_gpu_reg>;
};

&mfg {
	domain-supply = <&mt6358_vgpu_reg>;
};

/*
 * Rails the vendor keeps up that nothing in this tree consumes yet. Thirty seconds after boot the
 * regulator core switched them off (console log 2026-09-25: "vdram2: disabling" was the last line
 * before the reset) -- VDRAM2 feeds the DRAM. mt8183-kukui marks vdram2 always-on for the same reason.
 */
&mt6358_vdram2_reg {
	regulator-always-on;
};

&mt6358_vio28_reg {
	regulator-always-on;
};

&mt6358_vaux18_reg {
	regulator-always-on;
};

&mt6358_vbif28_reg {
	regulator-always-on;
};

&mt6358_vaud28_reg {
	regulator-always-on;
};

/*
 * USB. The vendor's usb3@11200000 (live.dts:4160, mediatek,usb3) is mainline's mtu3 at 11201000 with the
 * xhci child at 11200000, and its PHY (live.dts:6164 usb3_phy) is phy-mtk-tphy at 11f40000. Both are
 * mt8183.dtsi's nodes; the SoC block is the same one.
 *
 * All of it stays disabled. Type-C is on the MT6370's TCPC at i2c 0x4e (live.dts:3023 usb_type_c@4e), not
 * on the FUSB301A at i2c-3 0x25: that one is a Type-C CC controller the vendor uses to steer the USB3 lane
 * mux (pins 176 and 177, aeon_fusb301a_sw_sel/sw_en, live.dts:7454) and it has no mainline driver, so it
 * is not described. The TCPC has no separate i2c client in the mainline binding; it is the tcpc child of
 * the MT6370 node.
 */
&u3phy {
	/* on in mt8183.dtsi; nothing may power the PHY until the port above it is described and enabled */
	status = "okay";
};

&ssusb {
	/*
	 * Host only for now: the Type-C controller (MT6370 TCPC) that would drive role switching is not
	 * enabled yet, and what this port needs first is a network -- a USB Ethernet dongle, which
	 * NetworkManager on the Debian root DHCPs by itself. VBUS: the vendor boosts it from the MT6370
	 * (otg_vbus), not described yet; a powered hub or PD pass-through dongle does not need it.
	 */
	dr_mode = "host";
	vusb33-supply = <&mt6358_vusb_reg>;
	status = "okay";
};

&usb_host {
	vusb33-supply = <&mt6358_vusb_reg>;
	status = "okay";
};


&pio {
	/*
	 * live.dts:7464 aeon_usb_lr_sw_low/high (pin 79): the vendor switches the USB data lines between the
	 * two USB ports with this pin. Low is the left port in Otto's tree. WAITING: which level the
	 * vendor's default state is, and which port is which, are not in the live tree.
	 */
	usb_default_pins: usb-default-pins {
		pins-lr-switch {
			pinmux = <PINMUX_GPIO79__FUNC_GPIO79>;
			output-low;
		};
	};
};
