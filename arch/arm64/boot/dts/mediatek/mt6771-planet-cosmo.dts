// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Planet Computers Cosmo Communicator (board k71v1_64_bsp) on MediaTek MT6771.
 */

/dts-v1/;
#include "mt6771.dtsi"

/ {
	model = "Planet Computers Cosmo Communicator";
	chassis-type = "handset";
	compatible = "planet,cosmo", "mediatek,mt6771";

	aliases {
		serial0 = &uart0;
	};

	memory@40000000 {
		device_type = "memory";
		/*
		 * 6 GiB from 0x40000000. Two independent sources: the device
		 * owner, and Otto Pflueger's mt6771-planet-cosmocom.dts:29
		 * (reg = <0 0x40000000 1 0x80000000>). The vendor's own size,
		 * 0x1e605000 (V:226), is a bring-up value that stops at the
		 * framebuffer base and is not used. The base is the vendor's.
		 * Not proven: that the range is contiguous, with no hole the
		 * firmware owns; only a boot settles that.
		 */
		reg = <0 0x40000000 1 0x80000000>;
	};

	chosen {
		/* 921600 from vendor mt6771.dts:32 (console=ttyS0,921600n1) */
		stdout-path = "serial0:921600";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * OPTIONAL, UNPROVEN: the buffer LK hands over, as a screen
		 * console when the UART is silenced (printk.disable_uart=1).
		 * Delete this node and the reservation below to drop it.
		 *
		 * WAITING: LK reports islcm_inited = 0, i.e. it may leave the
		 * panel uninitialised, in which case this shows nothing. It is
		 * only proven when something appears on the screen.
		 *
		 * Base/size: chosen/atag,videolfb-fb_base_l and -vramSize.
		 * 0x17bb000 is 1080*1920*4*3, so LK sized it for a 1920-line
		 * panel, three pages. Geometry is fb0 as the vendor kernel
		 * reports it (1080x2160, stride 4352 = 1088*4, MTK_FB_ALIGNMENT
		 * 32). STAND-IN: if LK draws with stride 4320 the picture is
		 * sheared; adjust once seen.
		 * Format: mtkfb_fbinfo_init() (mt6771/videox/mtkfb.c:2077-2081)
		 * sets red at bit 0, blue at 16, alpha 24: a8b8g8r8, not
		 * a8r8g8b8. Confirmed on the running device:
		 * FBIOGET_VSCREENINFO gives 1080x2160, 32bpp, red 0, green 8,
		 * blue 16, alpha 24, and fb0/stride is 4352.
		 */
		framebuffer@5e605000 {
			compatible = "simple-framebuffer";
			reg = <0 0x5e605000 0 0x17bb000>;
			width = <1080>;
			height = <2160>;
			stride = <4352>;
			format = "a8b8g8r8";
		};
	};

	/*
	 * Targets for the vendor device-tree overlay. Not hardware.
	 *
	 * MediaTek's LK applies the overlay in the device's dtbo partition to whatever tree it finds in the
	 * boot image, and it is not optional: when a fixup cannot be resolved it does not fall back, it
	 * asserts, and the kernel never runs. Read out of expdb after a silent boot:
	 *
	 *   ERROR: ufdt_overlay_do_fixups():No node __symbols__ in main dtb.
	 *   ufdt_apply_overlay() failed!
	 *   panic (caller 0x5602c2d3): ASSERT at (app/mt_boot/fdt_op.c:212): 0
	 *
	 * The overlay names 61 symbols. Inheriting mt8183.dtsi supplies 18 of them; these
	 * 43 are vendor board labels with no mainline equivalent. They exist so the overlay
	 * resolves and LK proceeds, and they are deliberately empty and disabled so that whatever the overlay
	 * writes into them binds to nothing. Pointing them at real nodes would let 280 fragments of downstream
	 * properties into hardware we do describe.
	 *
	 * ci/check-dtbo-symbols.py reads the requirement out of the real dtbo partition, so this list cannot
	 * drift from the device without the build failing.
	 */
	lk-dtbo-stubs {
		status = "disabled";

		accdet: accdet-stub { };
		als: als-stub { };
		apuart0: apuart0-stub { };
		audgpio: audgpio-stub { };
		aw9523_eint: aw9523-eint-stub { };
		aw9523_key: aw9523-key-stub { };
		aw9524_key: aw9524-key-stub { };
		charger: charger-stub { };
		chosen: chosen-stub { };
		consys: consys-stub { };
		cs_finger: cs-finger-stub { };
		dsi_te: dsi-te-stub { };
		finger: finger-stub { };
		finger_key: finger-key-stub { };
		fusb301a: fusb301a-stub { };
		gpio: gpio-stub { };
		gpio_usage_mapping: gpio-usage-mapping-stub { };
		gyro: gyro-stub { };
		hall: hall-stub { };
		irq_nfc: irq-nfc-stub { };
		irtx_pwm: irtx-pwm-stub { };
		kd_camera_hw1: kd-camera-hw1-stub { };
		keypad: keypad-stub { };
		main_pmic: main-pmic-stub { };
		md1_sim1_hot_plug_eint: md1-sim1-hot-plug-eint-stub { };
		msdc1_ins: msdc1-ins-stub { };
		mt6370_pmu: mt6370-pmu-stub { };
		mt6370_typec: mt6370-typec-stub { };
		mt_pmic_vcama1_ldo_reg: mt-pmic-vcama1-ldo-reg-stub { };
		mt_pmic_vcama2_ldo_reg: mt-pmic-vcama2-ldo-reg-stub { };
		mt_pmic_vcamd_ldo_reg: mt-pmic-vcamd-ldo-reg-stub { };
		mt_pmic_vcamio_ldo_reg: mt-pmic-vcamio-ldo-reg-stub { };
		mt_pmic_vldo28_ldo_reg: mt-pmic-vldo28-ldo-reg-stub { };
		mt_pmic_vsim1_ldo_reg: mt-pmic-vsim1-ldo-reg-stub { };
		mt_pmic_vsim2_ldo_reg: mt-pmic-vsim2-ldo-reg-stub { };
		odm: odm-stub { };
		pmic_clock_buffer_ctrl: pmic-clock-buffer-ctrl-stub { };
		reserved_memory: reserved-memory-stub { };
		sii9022: sii9022-stub { };
		stm32_key: stm32-key-stub { };
		subpmic_pmu_eint: subpmic-pmu-eint-stub { };
		tcpc_pd: tcpc-pd-stub { };
		touch: touch-stub { };
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * The vendor pstore (V:298-301). Mainline ramoops takes the
		 * place of the vendor's own pstore. Sizes are the vendor's:
		 * console/pmsg from k71v1_64_bsp_defconfig:496-497, and the
		 * 4096-byte record size is the vendor ram.c default (ram.c:41).
		 * No no-map: it has to be mapped to be read back.
		 */
		ramoops@54410000 {
			compatible = "ramoops";
			reg = <0 0x54410000 0 0xe0000>;
			record-size = <0x1000>;
			console-size = <0x40000>;
			pmsg-size = <0x10000>;
		};

		/* Vendor ram_console (V:302-305) and minirdump (V:306-309). */
		ram-console@54400000 {
			reg = <0 0x54400000 0 0x10000>;
		};

		minirdump@544f0000 {
			reg = <0 0x544f0000 0 0x10000>;
		};

		/*
		 * Regions the firmware owns, at the addresses it chose for
		 * this boot, from the live device tree the bootloader hands
		 * the vendor kernel (notes: probes/2026-09-24-1702-live.dts,
		 * reserved-memory node; line numbers below are that file's).
		 * The vendor source only declares most of these dynamically.
		 * Not reserving them lets the page allocator hand ATF, TEE or
		 * modem memory to the kernel. All no-map except where noted.
		 *
		 * The addresses are as observed on one boot. If LK places them
		 * differently on another boot these are wrong; see the notes.
		 */

		/* live:6068 mblock-4-atf-reserved */
		atf@54600000 {
			reg = <0 0x54600000 0 0x40000>;
			no-map;
		};

		/* live:6074 mblock-9-SPM-reserved */
		spm@77ff0000 {
			reg = <0 0x77ff0000 0 0x10000>;
			no-map;
		};

		/* live:5951 mblock-5-SSPM-reserved */
		sspm@7ff00000 {
			reg = <0 0x7ff00000 0 0xc0000>;
			no-map;
		};

		/* live:5987 mblock-3-log_store; mapped (no no-map in the live tree) */
		log-store@7ffc0000 {
			reg = <0 0x7ffc0000 0 0x40000>;
		};

		/* live:5971 mblock-7-framebuffer */
		framebuffer@7df70000 {
			reg = <0 0x7df70000 0 0x1f90000>;
			no-map;
		};

		/* live:6023 mblock-13-ccci */
		ccci@8a000000 {
			reg = <0 0x8a000000 0 0x1600000>;
			no-map;
		};

		/* live:6006 mblock-11-ccci */
		ccci@8c000000 {
			reg = <0 0x8c000000 0 0x100000>;
			no-map;
		};

		/* live:6012 mblock-12-ccci; mapped (no no-map in the live tree) */
		ccci@66000000 {
			reg = <0 0x66000000 0 0x10000000>;
		};

		/* live:6017 mblock-10-SCP-reserved */
		/*
		 * Labelled because mt8183.dtsi's scp@10500000 references
		 * scp_mem_reserved by name; the SoC file will not compile without
		 * it. Otto's tree puts this at 0x50000000, which looks inherited
		 * from an MT8183 board — the live tree on this device says
		 * 0x9cf00000, and the device wins.
		 */
		scp_mem_reserved: scp@9cf00000 {
			reg = <0 0x9cf00000 0 0x600000>;
			no-map;
		};

		/* live:6036 mblock-8-vpu_binary */
		vpu@9d5f0000 {
			reg = <0 0x9d5f0000 0 0x2a10000>;
			no-map;
		};

		/*
		 * live:5942 reserve-memory-sspm_share. LK looks this up by literal path,
		 * "/reserved-memory/reserve-memory-sspm_share", and writes "okay" into its status property --
		 * which is why the live tree shows status = <0x6f6b6179>, "okay" as a u32. Without the node LK
		 * logs "SSPM: no reserved mem found, skip" and shortly afterwards asserts. Values are the
		 * device's, not invented: a dynamic reservation rather than a fixed one.
		 */
		reserve-memory-sspm_share {
			compatible = "mediatek,reserve-memory-sspm_share";
			size = <0 0x510000>;
			alloc-ranges = <0 0x40000000 0 0x60000000>;
			alignment = <0 0x10000>;
			no-map;
		};

		/* live:6042 mblock-6-tee-reserved */
		tee@edb00000 {
			reg = <0 0xedb00000 0 0x2440000>;
			no-map;
		};

		/* live:6000 mblock-1-dramc-rk0 */
		dramc-rk0@bffff000 {
			reg = <0 0xbffff000 0 0x1000>;
			no-map;
		};

		/* live:5965 mblock-2-dramc-rk1 */
		dramc-rk1@1bffff000 {
			reg = <1 0xbffff000 0 0x1000>;
			no-map;
		};

		/*
		 * The three pools below are placed by the kernel at boot from
		 * size, alignment and alloc-ranges (as in the vendor), not at a
		 * fixed address, and nothing consumes them until the SSPM, SCP
		 * and connsys drivers exist.
		 */

		/*
		 * V:312-323: 5M + 64K; the 1M + 64K variant needs
		 * CONFIG_MTK_GMO_RAM_OPTIMIZE or CONFIG_MTK_MET_MEM_ALLOC,
		 * set in neither k71v1_64_bsp defconfig.
		 */
		sspm-shared {
			no-map;
			size = <0 0x510000>;
			alignment = <0 0x10000>;
			alloc-ranges = <0 0x40000000 0 0x60000000>;
		};

		/* V:324-330: 20 MB */
		scp-shared {
			no-map;
			size = <0 0x1400000>;
			alignment = <0 0x1000000>;
			alloc-ranges = <0 0x40000000 0 0x50000000>;
		};

		/* V:331-337 */
		consys {
			no-map;
			size = <0 0x200000>;
			alignment = <0 0x200000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};
		/*
		 * Protects the optional framebuffer in /chosen above from the
		 * allocator. Not one of the firmware regions: this is the
		 * buffer LK hands over, kept alive on purpose.
		 */
		framebuffer-lk@5e605000 {
			reg = <0 0x5e605000 0 0x17bb000>;
			no-map;
		};
	};

};

&uart0 {
	status = "okay";
};

/*
 * LK finds the SCP node by the vendor compatible "mediatek,scp" and reads its sram size from reg[0].
 * Without it: "[SCP] platform_fdt_scp: getting node from dtb fails". mt8183.dtsi's node already carries
 * the right reg -- sram at 0x10500000 size 0x80000, identical to the vendor tree (live:7006) -- so all
 * it needs is the name the bootloader looks for. The node stays disabled; LK only reads it.
 */
&scp {
	compatible = "mediatek,mt8183-scp", "mediatek,scp";
};
