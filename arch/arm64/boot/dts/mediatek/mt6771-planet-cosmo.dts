/*
 * Planet Computers Cosmo Communicator (board k71v1_64_bsp) on MediaTek MT6771.
 */

/dts-v1/;
#include "mt6771.dtsi"

/ {
	model = "Planet Computers Cosmo Communicator";
	chassis-type = "handset";
	compatible = "planet,cosmo", "mediatek,mt6771";

	aliases {
		serial0 = &uart0;
	};

	memory@40000000 {
		device_type = "memory";
		/*
		 * The base is the vendor's (V:226). Its size, 0x1e605000, is not
		 * used: it ends exactly at the framebuffer base 0x5e605000
		 * (k71v1_64_bsp.dts:25), a bring-up value, and nothing in the
		 * vendor tree gives the real RAM size. We expect the bootloader
		 * to fill in the size; if it does not, there is no RAM at all.
		 * STAND-IN: size 0 becomes the real size once known.
		 */
		reg = <0 0x40000000 0 0>;
	};

	chosen {
		/* 921600 from vendor mt6771.dts:32 (console=ttyS0,921600n1) */
		stdout-path = "serial0:921600";
	};
};

&uart0 {
	status = "okay";
};
