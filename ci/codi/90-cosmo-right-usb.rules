# Right USB-C partner = the typec port of the FUSB301 (i2c 3-0025); port numbers follow probe order.
# Tell the cover MCU like Android's AmoledisonService: it switches the right D+/D- only after CMD 144.
SUBSYSTEM=="typec", KERNEL=="port*-partner", DEVPATH=="*/3-0025/typec/*", ACTION=="add", RUN+="/bin/systemctl --no-block start cosmo-right-usb@attach.service"
SUBSYSTEM=="typec", KERNEL=="port*-partner", DEVPATH=="*/3-0025/typec/*", ACTION=="remove", RUN+="/bin/systemctl --no-block start cosmo-right-usb@detach.service"
