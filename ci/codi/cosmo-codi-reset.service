[Unit]
Description=Reset the cover display MCU (the vendor kernel does this at every boot)
ConditionKernelVersion=!4.*

[Service]
Type=oneshot
ExecStart=/usr/bin/codi-reset
# A reset forgets the right-port OTG status (CMD 144): resend it once the MCU is up again
ExecStartPost=/bin/sh -c 'sleep 2; ls -d /sys/bus/i2c/drivers/fusb301/*/typec/port*/port*-partner >/dev/null 2>&1 && /bin/systemctl --no-block restart cosmo-right-usb@attach.service || true'

[Install]
WantedBy=multi-user.target
