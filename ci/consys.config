# Fragment for `ci/local-ci.sh --job consys`: applied on top of allnoconfig, so `make modules` builds
# the CONSYS port and little else. Only what the port depends on, plus the port itself as a module.
CONFIG_ARM64=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PROC_FS=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_GPIOLIB=y
CONFIG_MMC=y
CONFIG_RTC_CLASS=y
CONFIG_PM=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT6771_CONSYS=m
