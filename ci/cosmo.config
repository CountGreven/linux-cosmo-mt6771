# Fragment for a Cosmo test kernel, on top of arm64 defconfig.
# Everything here exists because of something the device told us.

# The bootloader disables the UART console, and 4.4 has no framebuffer console,
# so the screen is the channel we can actually control.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# fbcon=rotate: and /sys/class/graphics/fbcon/rotate do nothing without this; the panel is portrait.
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_LOGO=y

# console-ramoops is the proven channel across a reboot on this hardware.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y

# The UART, AS a console -- restored, and the earlier reasoning here was backwards.
#
# It was removed on the theory that mainline honours LK's console=ttyS0 literally and printk would block
# on an unclocked UART. The data says the opposite. Regenerating the configs and diffing: removing it
# changed exactly SERIAL_8250_CONSOLE, SERIAL_CORE_CONSOLE, SERIAL_EARLYCON and EFI_EARLYCON, and the
# very next build regressed from reaching register_console at arch_initcall_sync to dying before
# postcore. Every build that has ever got past postcore had this console; every build without it has
# died at or before core. Mechanism unknown -- timing is the likeliest, since tens of KB at 921600 baud
# adds seconds to early boot and can mask a race -- but the correlation is three-for-three.
#
# TESTED, single variable, 2026-09-25 00:06: restoring this alone did NOT carry the boot past core --
# still COSMO-MARK-6, watchdog reset at ~12 s from selection. So the table above hid a second variable:
# every build that got further also had "earlycon keep_bootcon" on the cmdline, and this one does not.
# The console driver stays on (it is harmless and may be needed for earlycon); the earlycon question is
# open, and the initcall tracer in init/main.c is the instrument that names the hang directly.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y

# Say as much as possible on the way up: this is a bring-up kernel, not a daily driver.
# No EARLY_PRINTK either: it writes to the same UART, before any of it is proven.
CONFIG_DEBUG_INFO=y

# Let a hang reset the device by itself.
#
# LK arms MediaTek's hardware watchdog before it jumps -- that is what produced "lk_wdt_dump(): watchdog
# timeout in LK...." when LK hung, about 9.5 seconds after the fact. arm64 defconfig then enables both
# MEDIATEK_WATCHDOG and WATCHDOG_HANDLE_BOOT_ENABLED, and the watchdog core adopts a bootloader-started
# watchdog and pets it from a kernel worker. So our kernel kept itself alive through a hang: the display
# went wild, then black, and the device sat there until the power button was held -- and holding it long
# enough to power down took the ramoops log with it.
#
# With the driver out, nothing pets the watchdog LK armed, so a hang becomes a hardware reset after about
# ten seconds. That is a warm reset, so the log survives, and it removes the guesswork about how long to
# wait before forcing one.

# And a panic should not sit there either. The cmdline passes panic=5 as well.
CONFIG_PANIC_TIMEOUT=5

# Built in, not modules.
#
# We boot with no ramdisk and no rootfs, so nothing can ever load a module: every =m driver is simply
# absent. arm64 defconfig makes the whole display stack modular, which means mtk_drm was never loaded on
# any attempt so far -- so it cannot have been what drove garbage onto the panel, and Otto's panel entry
# would have sat in a module that never loads.
#
# Anything this kernel actually needs has to be =y until there is a rootfs.
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
# DRM_PANEL_SIMPLE depends on BACKLIGHT_CLASS_DEVICE, which defconfig leaves modular -- so the panel
# driver silently stayed =m even when asked for =y. A tristate cannot be built in while a dependency is a
# module, and kconfig does not complain; it just quietly gives you =m.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_MTK_MMSYS=y
CONFIG_MTK_CMDQ=y
CONFIG_REGULATOR_MT6358=y
CONFIG_MFD_MT6397=y
CONFIG_MTK_PMIC_WRAP=y

# The kernel reached systemd on 2026-09-25 and was killed at ~10 s by the watchdog LK arms before
# jumping to us. Pet it from boot (the mtk_wdt driver binds the mt8183 toprgu node in the dtsi) until
# userspace takes over. Until now this was off on purpose, so a hung kernel reset itself.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_MEDIATEK_WATCHDOG=y

# USB host on mtu3/xhci with the common USB Ethernet chipsets built in (no modules on the rootfs):
# a Type-C Ethernet dongle is mainline's first network; NetworkManager on the Debian root DHCPs it.
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_LAN78XX=y
CONFIG_USB_NET_RNDIS_HOST=y

# MT6370 sub-PMIC on i2c11: its charger's OTG boost is the only 5 V source for USB host mode.
CONFIG_IIO=y
CONFIG_MFD_MT6370=y
CONFIG_MEDIATEK_MT6370_ADC=y
CONFIG_CHARGER_MT6370=y
CONFIG_REGULATOR_MT6370=y

# Type-C port controller on the MT6370 and the TCPM stack: the port sources VBUS and becomes host
# only on an attach, as the vendor does.
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MT6370=y
CONFIG_USB_ROLE_SWITCH=y

CONFIG_DYNAMIC_DEBUG=y
# kexec: iterate from the running mainline over the dongle instead of the LK menu. kexec_load (kexec-tools
# -l Image --dtb) and kexec_file_load both; the DRAM is never reset, so pstore survives the hop.
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
# Core power-down after hotplug: the firmware parks a dead core powered, and it never comes back
# without MTK_SIP_POWER_DOWN_CORE. Without this, kexec'd kernels are single-core (19-kexec.org).
CONFIG_HOTPLUG_CPU=y
CONFIG_MTK_MT6771_CPU_PM=y
# Wireless core for the CONSYS wifi port (17-consys-port): the vendor wlan driver compiles its
# wireless-extensions glue unconditionally, and cfg80211 built as a module against a kernel without
# WEXT could not load (wireless_nlevent_flush). cfg80211 and rfkill go in the image; only the four
# vendor modules are loaded from Debian.
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_PRIV=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_RFKILL=y
CONFIG_NL80211_TESTMODE=y
# The vendor CONSYS wifi stack as modules (17-consys-port); loaded from Debian for bring-up.
CONFIG_MT6771_CONSYS=m
CONFIG_NL80211_TESTMODE=y
# Lockup detectors: a shutdown hang after the consys block was powered leaves no log; with these a
# spinning CPU or a stuck task panics (via sysctl softlockup_panic/hung_task_panic), the panic path
# resets through PSCI (proven with sysrq-b) and pstore keeps the trace.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30

# Cosmo keyboard: AW9523B expander on i2c4 (vendor dtbo fragment@40, address 0x5b), 8x7 matrix.
CONFIG_PINCTRL_AW9523=m
CONFIG_KEYBOARD_MATRIX=m
