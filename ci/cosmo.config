# Fragment for a Cosmo test kernel, on top of arm64 defconfig.
# Everything here exists because of something the device told us.

# The bootloader disables the UART console, and 4.4 has no framebuffer console,
# so the screen is the channel we can actually control.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y

# console-ramoops is the proven channel across a reboot on this hardware.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y

# The UART driver, but NOT as a console.
#
# LK puts "console=ttyS0,921600n1 printk.disable_uart=1" on the cmdline. printk.disable_uart is a
# MediaTek downstream patch -- their kernel/printk/printk.c declares it and gates UART output on it -- so
# the vendor kernel registers that console and then never writes to it. Mainline has no such parameter
# and takes console=ttyS0 at face value.
#
# We are the ones who made that reachable, by enabling SERIAL_8250_CONSOLE. If the UART is not clocked
# under mainline, or printk spins on a TX-ready bit that never comes, printk blocks forever -- which
# matches what we saw: the display lights up, the first message after that wedges the machine, and the
# CON_PRINTBUFFER replay into pstore never completes.
#
# Leaving the console out means console=ttyS0 names a console that does not exist and is ignored. The
# driver stays for when we have a cable and can prove the UART works.
CONFIG_SERIAL_8250=y
# CONFIG_SERIAL_8250_CONSOLE is not set
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y

# Say as much as possible on the way up: this is a bring-up kernel, not a daily driver.
# No EARLY_PRINTK either: it writes to the same UART, before any of it is proven.
CONFIG_DEBUG_INFO=y

# Let a hang reset the device by itself.
#
# LK arms MediaTek's hardware watchdog before it jumps -- that is what produced "lk_wdt_dump(): watchdog
# timeout in LK...." when LK hung, about 9.5 seconds after the fact. arm64 defconfig then enables both
# MEDIATEK_WATCHDOG and WATCHDOG_HANDLE_BOOT_ENABLED, and the watchdog core adopts a bootloader-started
# watchdog and pets it from a kernel worker. So our kernel kept itself alive through a hang: the display
# went wild, then black, and the device sat there until the power button was held -- and holding it long
# enough to power down took the ramoops log with it.
#
# With the driver out, nothing pets the watchdog LK armed, so a hang becomes a hardware reset after about
# ten seconds. That is a warm reset, so the log survives, and it removes the guesswork about how long to
# wait before forcing one.
CONFIG_MEDIATEK_WATCHDOG=n
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=n

# And a panic should not sit there either. The cmdline passes panic=5 as well.
CONFIG_PANIC_TIMEOUT=5

# Built in, not modules.
#
# We boot with no ramdisk and no rootfs, so nothing can ever load a module: every =m driver is simply
# absent. arm64 defconfig makes the whole display stack modular, which means mtk_drm was never loaded on
# any attempt so far -- so it cannot have been what drove garbage onto the panel, and Otto's panel entry
# would have sat in a module that never loads.
#
# Anything this kernel actually needs has to be =y until there is a rootfs.
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
# DRM_PANEL_SIMPLE depends on BACKLIGHT_CLASS_DEVICE, which defconfig leaves modular -- so the panel
# driver silently stayed =m even when asked for =y. A tristate cannot be built in while a dependency is a
# module, and kconfig does not complain; it just quietly gives you =m.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_MTK_MMSYS=y
CONFIG_MTK_CMDQ=y
CONFIG_REGULATOR_MT6358=y
CONFIG_MFD_MT6397=y
CONFIG_MTK_PMIC_WRAP=y
