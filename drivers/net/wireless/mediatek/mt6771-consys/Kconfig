config MT6771_CONSYS
	tristate "MediaTek MT6771 CONSYS wifi (vendor gen3 stack, compile-only port)"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on CFG80211
	depends on GPIOLIB
	depends on IPV6
	depends on MMC
	depends on RTC_CLASS
	select NL80211_TESTMODE
	select ZLIB_DEFLATE
	select WIRELESS_EXT
	select WEXT_PRIV
	default n
	help
	  The vendor 4.4 wifi stack for the CONSYS combo radio in the MT6771
	  (WMT/STP core, consys power-up, firmware download and the "gen3"
	  MT6631 wlan driver), carried into mainline unmodified in logic.

	  This is stage 1 of the port: it is meant to COMPILE against this
	  kernel, and nothing more. The platform services the vendor tree got
	  from its mt-plat headers (EMI MPU, clkbuf, PMIC rails, SPM, BTIF)
	  are stubs in mtk_plat_shim.h that log and return -ENOSYS, so the
	  driver cannot power the radio yet.

	  Say N. If unsure, say N.

config MT6771_CONSYS_BT
	tristate "MediaTek MT6771 CONSYS Bluetooth"
	depends on MT6771_CONSYS && BT
	help
	  Bluetooth function of the CONSYS combo radio as a kernel HCI
	  device, on the STP transport of the wifi stack.

config MT6771_CONSYS_GPS
	tristate "MediaTek MT6771 CONSYS GPS"
	depends on MT6771_CONSYS
	help
	  GPS function of the CONSYS combo radio: the vendor /dev/stpgps
	  and /dev/gps_emi character devices, unchanged in interface, for
	  the vendor mnld daemon.

config MT6771_CONSYS_FM
	tristate "MediaTek MT6771 CONSYS FM radio"
	depends on MT6771_CONSYS
	help
	  FM receiver function of the CONSYS combo radio (an MT6631 FM
	  core): the vendor /dev/fm character device, unchanged in
	  interface, for the vendor FM HAL.

config MTK_CONN_LTE_IDC_SUPPORT
	bool "LTE coexistence (IDC) messages with the modem"
	depends on MT6771_CONSYS && MTK_CONN_MD
	depends on MTK_CONN_MD = y || MT6771_CONSYS = m
	default y
	help
	  The WMT core exchanges in-device coexistence messages with the
	  modem's LTE layer through the connsys/modem bridge, and tells
	  the CONNSYS firmware at power-on that it shares the device with
	  LTE, as the vendor kernel does on this phone.

# The vendor Makefiles and sources test these by their vendor names. They
# are fixed for the one chip this directory supports and are not meant to
# be set by hand.
config MTK_COMBO_CHIP
	string
	depends on MT6771_CONSYS
	default "CONSYS_6771"

config MTK_PLATFORM
	string
	depends on MT6771_CONSYS
	default "mt6771"

config MTK_COMBO
	bool
	depends on MT6771_CONSYS
	default y

config MTK_COMBO_WIFI
	bool
	depends on MT6771_CONSYS
	default y

config MTK_COMBO_GPS
	bool
	depends on MT6771_CONSYS_GPS
	default y

config MTK_GPS_EMI
	bool
	depends on MT6771_CONSYS_GPS
	default y

config MTK_FMRADIO
	bool
	depends on MT6771_CONSYS_FM
	default y

config MACH_MT6771
	bool
	depends on MT6771_CONSYS
	default y

config MTK_BTIF
	bool
	depends on MT6771_CONSYS
	default y

config MTK_EMI
	bool
	depends on MT6771_CONSYS
	default y
